# 环境变量清单 · 复制为 .env.local 后填写
# 规则：
#   1) .env.local 绝不提交 Git；本文件是唯一可提交的模板
#   2) 只有 NEXT_PUBLIC_ 开头的变量会出现在浏览器里，其余一律只在服务端用
#   3) 本地 / Preview / Production 三套值分开，服务商后台的回调 URL 也要配三套
#   4) 第一版可以只填 SUPABASE 与 CLERK，其余留空 → 用 mockAdapter 跑通全流程

# ---------- 应用 ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000        # 本地；线上改成 https://你的域名
NEXT_PUBLIC_APP_NAME=my-app                      # 产品名（会显示在标题/邮件里）

# ---------- 数据库：Supabase → Project Settings → API ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key                  # 可公开，但仍建议只在服务端用
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # ⚠️ 服务端专用，泄露=数据库失守

# ---------- 登录：Clerk → API Keys ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx   # 可公开
CLERK_SECRET_KEY=sk_test_xxxx                    # ⚠️ 服务端专用
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# ---------- 支付 / 点数（MoR 类服务或 Stripe，任选其一） ----------
BILLING_PROVIDER=lemonsqueezy                    # lemonsqueezy | creem | stripe
BILLING_API_KEY=your-api-key                    # ⚠️ 服务端专用
BILLING_WEBHOOK_SECRET=your-webhook-secret      # ⚠️ 服务端专用，验签用 raw body
BILLING_PRODUCT_ID=your-product-or-price-id
BILLING_WEBHOOK_PATH=/api/billing/webhook       # 后台 Webhook URL 要指向 线上域名 + 这个路径

# ---------- AI 引擎（可全部留空，走 mockAdapter） ----------
OPENROUTER_API_KEY=                              # 文本/对话类（openrouter.ai）
REPLICATE_API_TOKEN=                            # 图像/音视频类（replicate.com）
FAL_API_KEY=                                    # 备用图像/视频引擎（fal.ai）
PRIMARY_ADAPTER=openrouter                      # 主引擎名，对应 src/adapters/<name>.ts
SECONDARY_ADAPTER=replicate                     # 备用引擎；留空则直接降级到 mock

# ---------- 成本与降级阈值 ----------
MAX_COST_PER_CALL=0.50                           # 单次调用成本上限（元），超过直接拒绝
ENGINE_TIMEOUT_MS=15000                          # 外部调用超时（毫秒）
MAX_RETRIES=1                                    # 每级引擎最多重试次数

# ---------- 文件存储：Cloudflare → R2 ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=                              # 自定义域名或签名 URL 基础地址
SIGNED_URL_TTL_SECONDS=3600                      # 签名 URL 有效期

# ---------- 观测（可选） ----------
NEXT_PUBLIC_GA_ID=                               # Google Analytics / Search Console 校验用
SENTRY_DSN=

# ---------- pSEO（可选，见提示词 P6） ----------
SITE_URL=https://你的域名
SITEMAP_REBUILD_CRON="0 3 * * *"                # 定时重建 sitemap
